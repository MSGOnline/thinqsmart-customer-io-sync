# ============================================
# ThinQsmart MySQL replica (alleen lezen)
# ============================================
DB_HOST=r2-db1-replica.cyv75atac9eg.eu-central-1.rds.amazonaws.com
DB_USER=msn_tom
DB_PASSWORD=jouw_database_wachtwoord
DB_NAME=r2_production

# ============================================
# Customer.io Track API
# Settings -> Account Settings -> API Credentials -> Track API Keys
# LET OP: dit zijn Site ID + Track API Key.
# NIET de App API key / Bearer token, die werkt hier niet.
# Kies eerst de juiste workspace bovenin Customer.io.
# ============================================
CUSTOMER_IO_SITE_ID=jouw_site_id
CUSTOMER_IO_TRACK_API_KEY=jouw_track_api_key

# eu of us. Jouw account zit in de EU, dus eu.
CUSTOMER_IO_REGION=eu

# ============================================
# Gemeente-filter: alleen deze plaatsen worden gesynct
# ============================================
GEMEENTE_PLACES=Amsterdam,Weesp,Amsterdam-Noord,Amsterdam-West,Amsterdam-Oost,Amsterdam-Zuid,Amsterdam-Zuidoost

# ============================================
# Deze adressen nooit naar Customer.io sturen
# ============================================
EXCLUDE_EMAILS=planning@thcontainers.nl,planning@paridoncontainers.nl,info@milieuservice.nl

# ============================================
# Startpunt bij een lege KV-store
# BELANGRIJK: zet dit op het HOOGSTE order-ID dat nu in de database staat.
# Laat je dit leeg, dan begint de sync bij 0 en mailt hij oude klanten.
# ============================================
START_FROM_ORDER_ID=

# ============================================
# Testmodus: true = alles filteren en rapporteren, niets versturen
# Zet op false (of haal weg) als je echt wilt gaan mailen.
# ============================================
DRY_RUN=true

# ============================================
# Beveiliging van het endpoint
# Genereer met: openssl rand -hex 32
# ============================================
WEBHOOK_SECRET=jouw_random_token

# ============================================
# Upstash for Redis / Vercel KV
# Worden automatisch toegevoegd als je de integratie koppelt.
# Niet zelf invullen.
# ============================================
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Reden voor de mail. Gaat mee als event.data.extra.
MAIL_EXTRA=vergunning_amsterdam
